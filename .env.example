# UI runs without a database. Copy to .env only when configuring PostgreSQL.
DATABASE_URL="postgresql://naypolika:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/naypolika?schema=public"
POSTGRES_USER=naypolika
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=naypolika
APP_URL=http://localhost:3000
# Reserved for phase two; generate a random value before implementing sessions.
SESSION_SECRET=
SMS_PROVIDER=disabled
SMS_API_KEY=
ADMIN_MOBILE=
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
