    "dotenv": "^17.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
